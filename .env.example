# Copy to .env for local use, or set these as variables in Railway.
# NEVER commit a filled-in .env (it is gitignored).

# --- Kalshi API credentials ---
KALSHI_API_KEY_ID=your-key-id-uuid
# Inline PEM. In Railway's variable editor you can paste the real multi-line key;
# in a .env file, encode newlines as \n on a single line.
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# --- Postgres ---
# Railway injects DATABASE_URL automatically once you add the Postgres plugin.
# For local export from your laptop, use Railway's PUBLIC Postgres URL
# (Postgres service -> Connect tab).
DATABASE_URL=postgresql://user:pass@host:5432/railway
